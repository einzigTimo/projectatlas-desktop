{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectAtlas Desktop",
  "version": "0.2.3",
  "identifier": "io.github.einzigtimo.projectatlas.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ProjectAtlas Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/einzigTimo/projectatlas-desktop-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMkY2MTk4RjA0NkYxMzQKUldRMDhVYndtR0V2dTBGZHdEVHBva20wK3RQVFA5Vmt1ZGFLNzZpZld5WUdmeHo2OHJOQk9BT2IK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "einzigTimo",
    "copyright": "einzigTimo",
    "category": "DeveloperTool",
    "shortDescription": "Token-Ersparnis von ProjectAtlas sichtbar machen",
    "longDescription": "Zeigt was, wie, wann, wo und wodurch ProjectAtlas Tokens gespart hat - je lokalem Projekt, mit stiller Aktualisierung im Hintergrund.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
